# ── TeamDev X Terminal — Environment Template ─────────────────────────────
# Copy to `.env` and adjust before deploying:
#   cp .env.example .env

# Port the server listens on (default: 7681)
PORT=7681

# Password required to access the terminal UI.
# ⚠️ ALWAYS change this before deploying to a public host!
TERMINAL_PASSWORD=R@b1u2004@

# Optional: if set, the server pings <KEEPALIVE_URL>/health every 25s
# to prevent idle spin-down on free-tier hosts (Railway, Render, Fly.io…).
KEEPALIVE_URL=

# Shell binary to spawn for PTY sessions (default: /bin/bash)
SHELL=/bin/bash

# ── Cloudflare WARP mesh connector ─────────────────────────────────────
# Optional: base64 connector token from your Cloudflare Zero Trust dashboard.
# When set, the entrypoint starts warp-svc, registers the connector, and
# connects to the Cloudflare mesh before launching the terminal.
# Requires --privileged or cap-add NET_ADMIN,SYS_ADMIN at runtime.
# Leave empty to run without the mesh.
WARP_TOKEN=