# ── TeamDev X Terminal — Environment Template ─────────────────────────────
# Copy to `.env` and adjust before deploying:
#   cp .env.example .env

# Port the server listens on (default: 8080)
PORT=8080

# Password required to access the terminal UI.
# ⚠️ ALWAYS change this before deploying to a public host!
TERMINAL_PASSWORD=R@b1u2004@

# Optional: if set, the server pings <KEEPALIVE_URL>/health every 25s
# to prevent idle spin-down on free-tier hosts (Railway, Render, Fly.io…).
KEEPALIVE_URL=

# Shell binary to spawn for PTY sessions (default: /bin/bash)
SHELL=/bin/bash

# ── Cloudflare Tunnel (cloudflared) ──────────────────────────────────────
# Optional: Tunnel token from Cloudflare Zero Trust dashboard →
# Networks → Tunnels → (your tunnel) → Configure → Install connector.
# When set, the entrypoint starts `cloudflared tunnel run --token <TOKEN>`
# automatically.  Works on any platform (Render, Railway, Fly.io, etc.)
# Leave empty to run without the tunnel.
# Docs: https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/
TUNNEL_TOKEN=